{
  "format_on_save": "on",
  "project_panel": {
    "show_diagnostics": "errors",
    "sort_mode": "mixed",
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right"
  },
  "always_treat_brackets_as_autoclosed": true,
  "icon_theme": "Soft Charmed Icons",
  "search": {
    "case_sensitive": true
  },
  "soft_wrap": "editor_width",
  "tabs": {
    "file_icons": true
  },
  "title_bar": {
    "show_branch_status_icon": true
  },
  "toolbar": {
    "breadcrumbs": true
  }
